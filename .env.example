# Application
APP_PORT=3000
APP_ENV=development
CORS_ALLOW_ORIGINS=*

# Gemini AI (required)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Storage: VM | FIREBASE
BUCKET_STORAGE=VM
STORAGE_LOCAL_PATH=./storage/public

# Firebase (required only when BUCKET_STORAGE=FIREBASE)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./storage/firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Logging
LOG_LEVEL=info
LOG_DIR=./storage/logs
