# Application
APP_PORT=3000
APP_ENV=development
# Production: set exact frontend origin(s), comma-separated. "*" is rejected when APP_ENV=production.
CORS_ALLOW_ORIGINS=*

# Monetization Phase 0–1
# Docker (API container → shared-infra): host = shared_postgres
# Local binary on host: host = 127.0.0.1 (port mapped from shared-infra)
DATABASE_URL=postgres://shared:CHANGE_ME_strong_postgres_password@shared_postgres:5432/splitbill?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_DAYS=30
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FREE_OCR_LIMIT=5

# Extract provider order (first tried first; on failure tries next):
#   gemini | groq | both | gemini,groq | groq,gemini
EXTRACT_PROVIDER=gemini,groq

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SEC=25

# Groq AI (required when EXTRACT_PROVIDER includes groq)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_SEC=25

# Storage: VM | FIREBASE
BUCKET_STORAGE=VM
STORAGE_LOCAL_PATH=./storage/public
STORAGE_RETENTION_DAYS=14
STORAGE_CLEANUP_INTERVAL_HOURS=24

# Firebase (required only when BUCKET_STORAGE=FIREBASE)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./storage/firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# HTTP hardening (Security Phase 1)
HTTP_BODY_LIMIT_BYTES=5242880
HTTP_READ_TIMEOUT_SEC=30
HTTP_WRITE_TIMEOUT_SEC=60
HTTP_IDLE_TIMEOUT_SEC=60
HTTP_CONCURRENCY=128
RATE_LIMIT_RPM=5
EXTRACT_MAX_CONCURRENT=5

# Logging
LOG_LEVEL=info
LOG_DIR=./storage/logs
