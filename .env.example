# Application
APP_PORT=3000
APP_ENV=development
# Production: set exact frontend origin(s), comma-separated. "*" is rejected when APP_ENV=production.
CORS_ALLOW_ORIGINS=*

# Gemini AI (required)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SEC=25

# Optional fallback when Gemini fails (503/high demand/etc.)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SEC=25

# Storage: VM | FIREBASE
BUCKET_STORAGE=VM
STORAGE_LOCAL_PATH=./storage/public

# Firebase (required only when BUCKET_STORAGE=FIREBASE)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./storage/firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# HTTP hardening (Security Phase 1)
HTTP_BODY_LIMIT_BYTES=5242880
HTTP_READ_TIMEOUT_SEC=30
HTTP_WRITE_TIMEOUT_SEC=60
HTTP_IDLE_TIMEOUT_SEC=60
HTTP_CONCURRENCY=128
RATE_LIMIT_RPM=5
EXTRACT_MAX_CONCURRENT=5

# Logging
LOG_LEVEL=info
LOG_DIR=./storage/logs
